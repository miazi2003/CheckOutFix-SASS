{
    "version": 2,
    "functions": {
        "backend/app.js": {
            "runtime": "nodejs@18.x"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/backend/app.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}